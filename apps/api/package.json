{
  "name": "@vex/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Vex Core: the operator service (agent loop, drivers, permissions, audit) that hosts embed.",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "test": "vitest run",
    "eval": "node evals/run.ts",
    "typecheck": "tsc -p tsconfig.json",
    "eval:export": "node evals/export.ts",
    "db:backup": "node scripts/backup.ts",
    "db:restore": "node scripts/restore.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@fastify/cors": "^11.3.1",
    "@vex/connectors": "workspace:*",
    "@vex/operator": "workspace:*",
    "@vexstudio/format": "workspace:*",
    "fastify": "^5.12.7",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vex/sample-tools": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
