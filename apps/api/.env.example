# Copy to .env (gitignored). Loaded by Node's process.loadEnvFile at start.

# Anthropic API key. Without it, Vex runs in "scripted" mode (deterministic keyword planner).
ANTHROPIC_API_KEY=

# auto (default): anthropic when a key is present, scripted otherwise. Or force one.
VEX_PROVIDER=auto

# Model for the anthropic provider.
VEX_MODEL=claude-opus-5-5

# How Vex names the platform it operates, in its instructions (e.g. your product name).
# VEX_HOST_NAME=la plataforma

# HTTP port and the pages allowed to call Vex Core from a browser (exact origins, comma separated).
# Default on a local server: the demo. Browsers from any other origin are refused.
PORT=8787
CORS_ORIGIN=http://localhost:5174,http://127.0.0.1:5174
# 127.0.0.1 = local only. Set 0.0.0.0 behind a proxy in production.
HOST=127.0.0.1

# Audit and conversations: a SQLite file (relative to apps/api) or "memory".
VEX_DB=data/vex.db

# Messages per user per minute.
VEX_RATE_LIMIT=20

# Model proxy for Vex Studio (POST /provider/complete). Default: on only when HOST is local.
# VEX_PROVIDER_PROXY=0

# Secret that signs session tokens (32+ characters). Without it, sessions die when the server restarts.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# VEX_TOKEN_SECRET=

# Demo login without password (POST /platform/auth/demo). Default: on only when HOST is local. Never in production.
# VEX_DEMO_LOGIN=0

# Connectors. Local MCP servers that may be started, as exact command lines (command and arguments),
# comma separated. An import must match an entry exactly. Default: none. Examples:
# VEX_MCP_ALLOW=node C:/Users/Portatil 5/Desktop/avataarsin/apps/sample-tools/src/notas-mcp.ts,C:/Program Files/VectorCraft/vectorcraft-cli.exe mcp --headless

# Secrets for connectors go here under the name chosen when importing them, e.g.:
# CITAS_TOKEN=
