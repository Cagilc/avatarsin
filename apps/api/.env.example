# Copy to .env (gitignored). Loaded by Node's process.loadEnvFile at start.

# Anthropic API key. Without it, Vex runs in "scripted" mode (deterministic keyword planner).
ANTHROPIC_API_KEY=

# auto (default): anthropic when a key is present, scripted otherwise. Or force one.
VEX_PROVIDER=auto

# Model for the anthropic provider.
VEX_MODEL=claude-opus-5-5

# HTTP port and the origin of the embedding page (CORS).
PORT=8787
CORS_ORIGIN=http://localhost:5174
# 127.0.0.1 = local only. Set 0.0.0.0 behind a proxy in production.
HOST=127.0.0.1

# Audit and conversations: a SQLite file (relative to apps/api) or "memory".
VEX_DB=data/vex.db

# Messages per user per minute.
VEX_RATE_LIMIT=20

# Model proxy for Vex Studio (POST /provider/complete). Default: on only when HOST is local.
# VEX_PROVIDER_PROXY=0
