# Copy to apps/server/.env. On a local server (HOST=127.0.0.1) nothing is required.

# Port and interface. Anything other than 127.0.0.1 is a public server: set the values below.
PORT=8788
HOST=127.0.0.1

# Exact origins of the studio UI allowed to call /api from a browser (comma separated).
STUDIO_ORIGIN=https://estudio.tudominio.com

# Public base URL of this server, used in the embed snippet.
STUDIO_PUBLIC_URL=https://estudio.tudominio.com

# Secret for session tokens (at least 32 bytes). Without it sessions end on restart.
STUDIO_TOKEN_SECRET=

# Ed25519 signing key for published avatars (PKCS#8, base64url). Without it a key file is created
# in data/signing-key.json. Keep this value out of the repository: whoever has it can sign avatars.
STUDIO_SIGNING_KEY=

# Password-less owner login. Only on a local server by default; never enable it on a public one.
STUDIO_DEV_LOGIN=0

# Database file (relative to apps/server) or "memory".
STUDIO_DB=data/studio.db

# Assistant: with ANTHROPIC_API_KEY it uses Claude; STUDIO_ASSISTANT=heuristic forces the geometric one.
ANTHROPIC_API_KEY=
STUDIO_MODEL=claude-opus-5-5
